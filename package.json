{
  "name": "atvik",
  "version": "3.2.1",
  "description": "Event handling using individual emitters and signals",
  "license": "MIT",
  "repository": "aholstenson/atvik",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm run lint && npm run coverage",
    "coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "rimraf dist",
    "prepublishOnly": "npm run build",
    "apidocs": "typedoc"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "event",
    "events",
    "signals",
    "observer",
    "listener",
    "emitter",
    "typed",
    "event-emitter"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-tsdoc": "^0.5.4",
    "rimraf": "^6.1.4",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
