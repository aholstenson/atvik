{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2022",
		"lib": [ "es2022", "esnext.disposable", "dom" ],

		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,

		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,

		"noEmit": true,

		"types": [ "node", "vitest/globals" ]
	},
	"include": [
		"src",
		"test"
	],
	"typedocOptions": {
		"entryPoints": [ "src/index.ts" ],
		"out": "apidocs",
		"excludePrivate": true
	}
}
